meta {
  name: Add participant
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/polls/{{slug}}/vote
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Alice",
    "votes": [
      { "slotId": "REPLACE_WITH_SLOT_ID_1", "status": "yes" },
      { "slotId": "REPLACE_WITH_SLOT_ID_2", "status": "maybe" }
    ]
  }
}

vars:pre-request {
  slug: REPLACE_WITH_SLUG
}
