{
	"name": "creno",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"dev:fullstack": "pnpm i && pnpm approve-builds && pnpm drizzle:generate && pnpm drizzle:migrate && pnpm nuxt dev --dotenv .env --host",
		"drizzle:studio": "drizzle-kit studio",
		"drizzle:generate": "drizzle-kit generate",
		"drizzle:migrate": "drizzle-kit migrate",
		"drizzle:push": "drizzle-kit push",
		"drizzle:pull": "drizzle-kit pull",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test": "vitest",
		"test:run": "vitest run",
		"test:server": "vitest --project server",
		"test:app": "vitest --project app",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "nuxt typecheck",
		"check": "pnpm i && pnpm format && pnpm lint && pnpm typecheck && pnpm test:run",
		"fix": "pnpm format:fix && pnpm lint:fix",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@compodium/nuxt": "0.1.0-beta.12",
		"@internationalized/date": "^3.11.0",
		"@libsql/client": "^0.17.0",
		"@nuxt/eslint": "1.15.2",
		"@nuxt/ui": "4.12.0",
		"@vueuse/core": "^14.2.1",
		"@vueuse/nuxt": "^14.2.1",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"nanoid": "^5.1.6",
		"nuxt": "^4.3.1",
		"uqr": "^0.1.3",
		"vue": "^3.5.28",
		"vue-router": "^4.6.4",
		"web-haptics": "^0.0.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@nuxt/test-utils": "^4.0.0",
		"@vue/test-utils": "^2.4.6",
		"drizzle-kit": "^0.31.9",
		"eslint": "^10.0.2",
		"eslint-plugin-prettier": "^5.5.5",
		"happy-dom": "^20.7.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"simple-git-hooks": "^2.14.0",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"vue-tsc": "^3.2.5"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"commit-msg": "pnpm exec commitlint --edit \"$1\""
	},
	"lint-staged": {
		"*.{ts,mjs,vue}": [
			"eslint --fix"
		],
		"*.{json,css,yml,yaml}": [
			"prettier --write"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@10.30.3"
}
