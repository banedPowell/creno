		"drizzle:pull": "drizzle-kit pull",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test": "vitest",
		"test:run": "vitest run",
		"test:server": "vitest --project server",
		"test:app": "vitest --project app",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "nuxt typecheck",
		"check": "pnpm i && pnpm format && pnpm lint && pnpm typecheck && pnpm test:run",
